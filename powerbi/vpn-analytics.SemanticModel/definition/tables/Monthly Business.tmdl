	partition 'Monthly Business' = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database(#"PostgreSQL Server", #"PostgreSQL Database", [Query = "SELECT month_start AS ""Month Start"", active_paid_subscribers AS ""Active Paid Subscribers"", ending_paid_subscribers AS ""Ending Paid Subscribers"", basic_active_subscribers AS ""Basic Active Subscribers"", pro_active_subscribers AS ""Pro Active Subscribers"", monthly_active_paid_users AS ""Monthly Active Paid Users"", regular_paid_users AS ""Regular Paid Users"", new_paid_users AS ""New Paid Users"", churned_users AS ""Churned Users"", cash_revenue_rub AS ""Cash Revenue Rub"", subscription_mrr_rub AS ""Subscription MRR Rub"", addon_mrr_rub AS ""Add-on MRR Rub"", extra_device_slots AS ""Extra Device Slots"", normalized_mrr_rub AS ""Normalized MRR Rub"", connection_failure_rate AS ""Connection Failure Rate"", traffic_gb AS ""Traffic GB"" FROM analytics.mart_monthly_business ORDER BY month_start"])
				in
				    Source

