/// Одна строка на завершённый календарный месяц: платящая база, выручка и использование VPN.
table 'Monthly Business'
	lineageTag: 585fdbc5-1986-47e8-9eb1-a12fe15e80a9

	/// Число платящих подписчиков на конец последнего видимого месяца.
	measure 'Ending Subscribers' =
			VAR _lastMonth = MAX('Monthly Business'[Month Start])
			RETURN
			    CALCULATE(
			        MAX('Monthly Business'[Ending Paid Subscribers]),
			        KEEPFILTERS('Monthly Business'[Month Start] = _lastMonth)
			    )
		formatString: #,##0
		displayFolder: Business KPIs
		lineageTag: a7ef0bf1-1656-419f-b627-1235ffd023cf

	/// Нормализованная месячная повторяющаяся выручка последнего видимого месяца, включая доплаты за устройства.
	measure MRR =
			VAR _lastMonth = MAX('Monthly Business'[Month Start])
			RETURN
			    CALCULATE(
			        MAX('Monthly Business'[Normalized MRR Rub]),
			        KEEPFILTERS('Monthly Business'[Month Start] = _lastMonth)
			    )
		formatString: #,##0 "₽"
		displayFolder: Business KPIs
		lineageTag: f59ee56a-5b0f-458d-8f86-010b4db2a72a

	/// Успешно полученная денежная выручка за выбранный период.
	measure Revenue = SUM('Monthly Business'[Cash Revenue Rub])
		formatString: #,##0 "₽"
		displayFolder: Business KPIs
		lineageTag: dfcc8bbb-cb6c-41b9-ba3f-df660a8c335b

	/// Новые платящие пользователи в последнем видимом месяце.
	measure 'New Paying Users' =
			VAR _lastMonth = MAX('Monthly Business'[Month Start])
			RETURN
			    CALCULATE(
			        MAX('Monthly Business'[New Paid Users]),
			        KEEPFILTERS('Monthly Business'[Month Start] = _lastMonth)
			    )
		formatString: #,##0
		displayFolder: Business KPIs
		lineageTag: 99a5cce8-91b3-4590-b38c-deef5de06302

	/// Пользователи, завершившие подписку в последнем видимом месяце.
	measure 'Churned Subscribers' =
			VAR _lastMonth = MAX('Monthly Business'[Month Start])
			RETURN
			    CALCULATE(
			        MAX('Monthly Business'[Churned Users]),
			        KEEPFILTERS('Monthly Business'[Month Start] = _lastMonth)
			    )
		formatString: #,##0
		displayFolder: Business KPIs
		lineageTag: ccead217-28e7-41bf-aea4-2603e1629a0a

	/// Успешный VPN-трафик в последнем видимом месяце, гигабайты.
	measure Traffic =
			VAR _lastMonth = MAX('Monthly Business'[Month Start])
			RETURN
			    CALCULATE(
			        MAX('Monthly Business'[Traffic GB]),
			        KEEPFILTERS('Monthly Business'[Month Start] = _lastMonth)
			    )
		formatString: #,##0.0 "ГБ"
		displayFolder: Service KPIs
		lineageTag: b8c09c32-0777-4663-8b9e-210a743f3f1c

	/// Доля неуспешных попыток подключения в последнем видимом месяце.
	measure 'Latest Connection Failure Rate' =
			VAR _lastMonth = MAX('Monthly Business'[Month Start])
			RETURN
			    CALCULATE(
			        MAX('Monthly Business'[Connection Failure Rate]),
			        KEEPFILTERS('Monthly Business'[Month Start] = _lastMonth)
			    )
		formatString: 0.0%
		displayFolder: Service KPIs
		lineageTag: d67220d5-1d5a-42cf-8e9c-cb7b383716e6

	column 'Month Start'
		dataType: dateTime
		isHidden
		formatString: dd.MM.yyyy
		lineageTag: 51fa62c7-5358-477a-ac83-882061154b5b
		summarizeBy: none
		sourceColumn: Month Start

